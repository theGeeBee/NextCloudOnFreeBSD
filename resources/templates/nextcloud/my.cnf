# Last-sorted drop-in; retain the package my.cnf and conf.d/server.cnf defaults.
[client-server]
port = 3306
socket = /var/run/mysql/mysql.sock

[client]
default-character-set = utf8mb4

[mysqld]
user = mysql
bind-address = 127.0.0.1
skip-name-resolve
datadir = /var/db/mysql
log_error = /var/log/mysql/mysqld.err
character_set_server = utf8mb4
collation_server = utf8mb4_bin
transaction_isolation = READ-COMMITTED
innodb_file_per_table = 1
innodb_buffer_pool_size = @@DB_BUFFER_MB@@M
innodb_flush_log_at_trx_commit = 1
innodb_doublewrite = ON
# Redo-log disk capacity, distinct from the in-memory log buffer below.
# Exceeds NC35 serverinfo's 128 MiB minimum without weakening durability.
innodb_log_file_size = 256M
innodb_log_buffer_size = 32M
innodb_use_native_aio = 0
query_cache_type = 0
query_cache_size = 0
max_connections = @@DB_CONNECTIONS@@
max_allowed_packet = 64M
tmp_table_size = 32M
max_heap_table_size = 32M
general_log = 0
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
server_id = 1
log_bin = /var/log/mysql/mysql-bin
binlog_format = ROW
sync_binlog = 1
binlog_expire_logs_seconds = 604800
max_binlog_size = 128M
